# Copy this file to `.env` in the repository root (one folder up; git ignores it) and fill in the
# values: web/vite.config.ts reads them from there. Supabase dashboard > Project Settings > API Keys.
#
# Both are bundled into the public site by design: the publishable key can only do what the
# database rules in supabase/migrations allow. Never put the secret (service_role) key or the
# database password here.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
