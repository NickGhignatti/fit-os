# Copy this file to `.env` (which git ignores) and fill in the values.
# Supabase dashboard > Project Settings > API.
#
# Both are bundled into the public site by design (the anon key can only call the
# put_transfer / take_transfer functions). Never put the service_role key or the database
# password here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
