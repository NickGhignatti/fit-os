{
  // Serves the built app (dist/) from Cloudflare's edge. No Worker code: static assets only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-os",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    // Deep links such as /workouts are client-side routes: answer them with index.html.
    "not_found_handling": "single-page-application"
  }
}
