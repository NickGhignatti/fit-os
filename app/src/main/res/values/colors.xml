<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens ("Quiet Swiss Modern"). Every colour the UI uses is named here by role,
  never by hue, so a re-skin is an edit to this file only. Add values-night/colors.xml
  with the same names to get a dark theme without touching any Kotlin.
-->
<resources>
    <!-- Surfaces -->
    <color name="canvas">#FBFBFA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_muted">#F4F4F2</color>
    <color name="track">#F3F4F6</color>
    <color name="border">#E5E7EB</color>
    <color name="divider">#ECEEF0</color>

    <!-- Ink -->
    <color name="ink">#111315</color>
    <color name="ink_secondary">#6B7280</color>
    <color name="ink_tertiary">#9CA3AF</color>
    <color name="ink_inverse">#FFFFFF</color>
    <color name="ink_pressed">#272A30</color>

    <!-- Completion / primary confirmation (moss green) -->
    <color name="accent">#15803D</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="accent_container">#DCFCE7</color>
    <color name="on_accent_container">#166534</color>

    <!-- Macronutrients -->
    <color name="protein">#4338CA</color>
    <color name="protein_container">#EEF2FF</color>
    <color name="carbs">#D97706</color>
    <color name="carbs_container">#FEF3C7</color>
    <color name="fat">#DC2626</color>
    <color name="fat_container">#FEE2E2</color>

    <!-- Chips and errors -->
    <color name="chip">#F3F4F6</color>
    <color name="on_chip">#4B5563</color>
    <color name="danger">#BA1A1A</color>
    <color name="danger_container">#FFDAD6</color>

    <color name="ic_launcher_background">#1B5E20</color>
</resources>
